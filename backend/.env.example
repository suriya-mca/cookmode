# Server
PORT=8080

# PostgreSQL (used by pgx, River queue, and golang-migrate)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cookmode?sslmode=disable

# Supabase Auth (HS256 JWT verification — only the secret is needed)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=your-meili-master-or-api-key

# Cloudflare R2 (recipe photos / thumbnails)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=cookmode-media

# Cloudflare Stream (video hosting)
CF_STREAM_ACCOUNT_ID=your-cloudflare-account-id
CF_STREAM_API_TOKEN=your-stream-api-token

# Nutrition APIs
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
USDA_API_KEY=
